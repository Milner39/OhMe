{
	"tasks": {
		"orm:generate": "drizzle-kit generate --config=./db-orm/drizzle.config.ts",
		"orm:migrate": "drizzle-kit migrate --config=./db-orm/drizzle.config.ts",
		"orm:push": "deno task orm:generate && deno task orm:migrate",
		"orm:test": "vitest --config=./tests/vitest.config.ts",
		"orm:test:push": "TESTING=true deno task orm:push",

		"server:serve": "deno run -E -R -N ./server/src/app.ts"
	},

	"imports": {
		"drizzle-orm": "npm:drizzle-orm@0.38.3",
		"drizzle-kit": "npm:drizzle-kit@0.30.1",
		"drizzle-zod": "npm:drizzle-zod@0.6.1",
		"pg": "npm:pg@8.13.1",
		"@types/pg": "npm:@types/pg@8.11.10",
		"@hono/zod-validator": "npm:@hono/zod-validator@0.4.2"
	}
}