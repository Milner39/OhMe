/*
	This file is only here to allow drizzle-kit commands to work correctly with
	path aliases.
*/

{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["../../*"],
			"~db-api/*": ["./*"],
			"~web-server/*": ["../web-server/*"],
			"#db-api-client/*": ["../../packages/db-api-client/*"],
			"#utils/*": ["../../packages/utils/*"],
		}
	}
}