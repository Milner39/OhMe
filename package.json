{
	"type": "module",
	"packageManager": "pnpm@10.0.0",
	"engines": {
		"node": ">=22.13.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"dev": "pnpm run -r --parallel dev",
		"build": "pnpm run -r build",
		"serve": "pnpm run -r --parallel serve",
		"test": "pnpm run -r --parallel test",

		"list": "pnpm list -r"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"typescript": "npm:typescript@^5.7.3",
		"@types/node": "npm:@types/node@^22.13.5",
		"tsx": "npm:tsx@^4.19.3",

		"cross-env": "npm:cross-env@^7.0.3",
		"dotenv": "npm:dotenv@^16.4.7",

		"vite": "npm:vite@^6.1.1",
		"vitest": "npm:vitest@^3.0.6",
		
		"hono": "npm:hono@^4.7.2",

		"zod": "npm:zod@^3.24.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild",
			"svelte-preprocess"
		]
	}
}