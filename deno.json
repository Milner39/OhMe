{
	"tasks": {
		"web-server:dev": "cd apps/web-server && deno task dev",
		"web-server:build": "cd apps/web-server && deno task build",
		"web-server:preview": "cd apps/web-server && deno task preview",
		"web-server:serve": "cd apps/web-server && deno task serve",



		"db-api:orm:generate": "cd apps/db-api && deno task orm:generate",
		"db-api:orm:migrate": "cd apps/db-api && deno task orm:migrate",
		"db-api:orm:push": "cd apps/db-api && deno task orm:push",
		"db-api:orm:test": "cd apps/db-api && deno task orm:test",
		"db-api:orm:test:push": "cd apps/db-api && deno task orm:test:push",
		
		"db-api:server:serve": "cd apps/db-api && deno task server:serve"
	},

	"imports": {
		"@types/node": "npm:@types/node@22.9.0",
		"dotenv": "npm:dotenv@16.4.5",
		"zod": "npm:zod@3.24.1",
		"vite": "npm:vite@5.4.11",
		"vitest": "npm:vitest@2.1.8",
		"hono": "npm:hono@4.6.14",


		"@/": "./",
		
		"~db-api/": "./apps/db-api/",
		"~web-server/": "./apps/web-server/",

		"#db-api-client/": "./packages/db-api-client/",
		"#utils/": "./packages/utils/"
	},
	"nodeModulesDir": "auto",

	"workspace": {
		"members": [
			"apps/*",
			"packages/*"
		]
	}
}