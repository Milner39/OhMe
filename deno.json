{
	"tasks": {
		"web:dev": "cd WebServer && deno task dev",
		"web:build": "cd WebServer && deno task build",
		"web:preview": "cd WebServer && deno task preview",
		"web:serve": "cd WebServer && deno task serve",

		"db:generate": "cd Database && deno task generate",
		"db:migrate": "cd Database && deno task migrate"
	},

	"imports": {
		"@types/node": "npm:@types/node@22.9.0",
		"dotenv": "npm:dotenv@16.4.5"
	},

	"nodeModulesDir": "auto",
	"workspace": {
		"members": [
			"WebServer/",
			"Database/"
		]
	}
}